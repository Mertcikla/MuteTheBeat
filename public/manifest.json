{
  "manifest_version": 3,
  "name": "MuteTheBeat",
  "short_name": "MuteTheBeat",
  "version": "1.0.0",
  "description": "Reduce background music on Twitch while keeping voices clear. Local audio processing with adjustable speech focus.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "MuteTheBeat", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'; worker-src 'self'" }
}
